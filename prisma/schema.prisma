// Golden Fantasy — esquema de base de datos.
// Épica 2: se agrega Product (catálogo público). El resto del modelo de
// datos (RawMaterial, MaterialLot, Production, ProductionMaterial,
// SMLVConfig, Order, OrderItem) llega en épicas posteriores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  ADMIN_OWNER
  ADMIN_COLLABORATOR
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now())
  orders       Order[]

  @@map("users")
}

/**
 * Pieza publicada en el catálogo. Sin variantes (talla/color), pero puede
 * tener varias unidades idénticas del mismo diseño (D7).
 * `status` decide si aparece en el catálogo — la épica 5 publicará acá el
 * resultado de una producción, que hasta entonces vive como DRAFT.
 * `stockQuantity` es cuántas unidades quedan: la épica de órdenes lo
 * descuenta, y en 0 la pieza deja de aparecer aunque siga PUBLISHED.
 * `specs` guarda pares [etiqueta, valor] (material, medidas, etc.) tal
 * como se muestran en el detalle — no necesitan su propia tabla.
 * `photos` va en orden: la primera es la principal y el resto alimentan la
 * fila de miniaturas del modal de detalle (wireframe 8.5).
 */
model Product {
  id            String        @id @default(uuid())
  name          String
  category      String
  price         Int
  description   String
  specs         Json
  photos        String[]
  stockQuantity Int           @default(1)
  status        ProductStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  orderItems    OrderItem[]

  @@index([category])
  @@index([status])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

/**
 * Pedido. Nace en PENDING al crear la preferencia de Mercado Pago y solo
 * pasa a PAID desde el webhook, nunca desde el navegador del comprador
 * (que puede cerrar la pestaña o mentir sobre el resultado).
 * `subtotal` y `total` son iguales en v1: no hay costo de envío (C4).
 */
model Order {
  id                      String      @id @default(uuid())
  buyerId                 String
  status                  OrderStatus @default(PENDING)
  shippingName            String
  shippingAddress         String
  shippingCity            String
  shippingPhone           String
  subtotal                Int
  total                   Int
  mercadopagoPaymentId    String?
  mercadopagoPreferenceId String?
  createdAt               DateTime    @default(now())
  buyer                   User        @relation(fields: [buyerId], references: [id])
  items                   OrderItem[]

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

/**
 * Línea del pedido. `unitPrice` es una copia del precio al momento de
 * comprar, no una referencia viva: si el taller sube el precio después,
 * lo que se cobró no debe cambiar (mismo criterio que el snapshot de
 * materiales en producciones).
 */
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  subtotal  Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
