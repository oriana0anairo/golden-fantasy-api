# --- Base de datos (Supabase / Neon) ---
# Conexión de la app (pooler de Supabase, puerto 6543) — usada en runtime.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) — usada por `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Secreto para firmar los JWT. Genera uno con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# URL(s) del frontend autorizadas. Separadas por coma si hay varias.
CORS_ORIGIN="http://localhost:3000"

# --- Seed del admin dueño (prisma/seed.ts) ---
ADMIN_OWNER_NAME="Nombre del dueño"
ADMIN_OWNER_EMAIL="dueno@goldenfantasy.co"
ADMIN_OWNER_PASSWORD="una-contrasena-fuerte"
