# --- Base de datos (Supabase) ---
# OJO: los valores entre <> son placeholders. Reemplázalos por los tuyos,
# NO copies estas líneas tal cual (Supabase responderá "tenant/user not found").
# Dónde sacarlos: panel de Supabase -> botón "Connect" -> pestaña ORMs.
#
# Runtime de la app: "Transaction pooler" (puerto 6543).
DATABASE_URL="postgresql://postgres.<TU-PROJECT-REF>:<TU-PASSWORD>@aws-0-<TU-REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migraciones (`prisma migrate`): "Session pooler" (puerto 5432).
# El transaction pooler no sirve acá: las migraciones necesitan DDL y locks.
DIRECT_URL="postgresql://postgres.<TU-PROJECT-REF>:<TU-PASSWORD>@aws-0-<TU-REGION>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Secreto para firmar los JWT. Genera uno con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# URL(s) del frontend autorizadas. Separadas por coma si hay varias.
CORS_ORIGIN="http://localhost:3000"

# --- Seed del admin dueño (prisma/seed.ts) ---
ADMIN_OWNER_NAME="Nombre del dueño"
ADMIN_OWNER_EMAIL="dueno@goldenfantasy.co"
ADMIN_OWNER_PASSWORD="una-contrasena-fuerte"
